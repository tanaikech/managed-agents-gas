# Gemini API Key (Required)
GEMINI_API_KEY="your-gemini-api-key-here"

# Persistent Sandbox Environment ID (Optional: Paste the ID from GAS or leave empty to provision a new one)
ENVIRONMENT_ID=""

# Target Google Drive Folder ID for uploaded artifacts (Required for tests 2 - 6)
TARGET_FOLDER_ID="your-google-drive-folder-id-here"

# Google OAuth Access Token for ggsrun (Optional: If left empty, falls back to `gcloud auth print-access-token`)
GGSRUN_AT=""